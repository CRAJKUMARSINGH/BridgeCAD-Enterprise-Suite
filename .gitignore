# tests/e2e/random_drawings/ is written by scripts/generate_random_drawings.py.
TEST-*/
tests/e2e/random_drawings/
.verify/
.bridge_repo_pdf_work/
.vercel/

# Persona robot walker output (screenshots + replay traces). The S1/S2 register
