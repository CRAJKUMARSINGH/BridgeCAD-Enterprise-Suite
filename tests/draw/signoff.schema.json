{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Drawing sign-off record",
  "type": "object",
  "required": ["sheet", "revision", "reviewed_by", "reviewed_on", "against", "compared", "geometry_sha"],
  "additionalProperties": false,
  "properties": {
    "sheet": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^[PCA][0-9]*$" },
    "reviewed_by": { "type": "string", "minLength": 2 },
    "reviewed_on": { "type": "string", "format": "date" },
    "against": { "type": "string", "minLength": 1 },
    "compared": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string", "minLength": 6 }
    },
    "geometry_sha": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "outcome": { "enum": ["confirmed", "confirmed_with_exceptions"], "default": "confirmed" },
    "exceptions": { "type": "array", "items": { "type": "string" } }
  }
}
