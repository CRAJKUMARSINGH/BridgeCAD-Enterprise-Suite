trufflehog_fresh.json

# ---------------------------------------------------------------------------
# Transient run-time output — regenerable, never source (see docs/USER-MANUAL.md §11)
# ---------------------------------------------------------------------------

# CLI default output trees written by `bridgecad-cli draw` / `bill` (note: distinct
# from the tracked exemplars already under outputs/<project>/)
output/
outputs/detail/

# Ad-hoc report / audit dumps
reports/

# Local verification captures written by scratch runs. Match only .txt/.xlsx so the
# tracked S1/S2 register artifacts/TRIAGE_LOG.md stays versioned.
artifacts/*.txt
artifacts/*.xlsx

# Wing geometry report — regenerated by the wing scripts. NOTE the stored name uses an
# underscore; the older rule above (wing-report.json) matched a hyphen and never fired.
wing_report.json

# Local reference-extraction / patch scratch (vendor dumps, not product source).
# Remove these two lines if you deliberately want them versioned.
CODE-JUNCTION/
ATTACHED ASSETS/*

