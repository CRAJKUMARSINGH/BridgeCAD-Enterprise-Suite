# =============================================================================
# BridgeCAD Enterprise Suite v0.1.0-rc1 — Environment Configuration
# =============================================================================
# USAGE:
#   cp .env.example .env
#   # Edit .env with real values — NEVER commit .env to version control
#   docker compose -f docker-compose.prod.yml up -d
#
# All variables have safe defaults for local development.
# Production REQUIRED fields are marked  ★ CHANGE IN PROD ★
# =============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
ENV=dev                                   # dev | staging | production
BRIDGECAD_VERSION=0.1.0-rc1
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR
TZ=Asia/Kolkata
LANG=en_IN.UTF-8

# ── Application Secrets  ★ CHANGE IN PROD ★ ──────────────────────────────────
APP_SECRET_KEY=change-me-to-64-random-hex-chars-minimum
ENCRYPTION_KEY=change-me-32-chars-for-fernet

# ── API Gateway ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2                             # 4+ in production
API_RELOAD=true                           # false in production
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8501,http://localhost:80
API_DOCS_ENABLED=true                     # false in production

# ── API Authentication ────────────────────────────────────────────────────────
# Format: "key1:role1,key2:role2"  roles: admin | engineer | viewer
# ★ CHANGE IN PROD ★ — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGECAD_API_KEYS=dev-insecure-key:admin
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_TTL_SECONDS=86400
AUTH_API_KEYS_ENABLED=true

# ── Database ──────────────────────────────────────────────────────────────────
# Dev: SQLite (automatic, no setup needed)
# Prod: set DATABASE_URL to postgres connection string  ★ CHANGE IN PROD ★
DATABASE_URL=                             # leave empty for SQLite default (~/.bridgecad/bridgecad.db)
# DATABASE_URL=postgresql+psycopg://bridgecad:PASSWORD@db:5432/bridgecad

POSTGRES_USER=bridgecad
POSTGRES_PASSWORD=changeme-in-prod       # ★ CHANGE IN PROD ★
POSTGRES_DB=bridgecad
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis Cache ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=changeme-in-prod          # ★ CHANGE IN PROD ★
CACHE_TTL_SECONDS=3600
CACHE_DRIVER=memory                      # memory | redis

# ── Object Storage (MinIO / S3) ───────────────────────────────────────────────
STORAGE_DRIVER=local                     # local | s3
STORAGE_LOCAL_ROOT=./.data/storage

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-in-prod     # ★ CHANGE IN PROD ★
STORAGE_S3_ENDPOINT=http://storage:9000
STORAGE_S3_REGION=ap-south-1
STORAGE_S3_KEY=minioadmin
STORAGE_S3_SECRET=changeme-in-prod       # ★ CHANGE IN PROD ★
STORAGE_S3_BUCKET=bridgecad
STORAGE_S3_PUBLIC_URL_PREFIX=

# ── Output / Temp Paths ───────────────────────────────────────────────────────
OUTPUT_DIR=./.data/output               # local dir for generated DXF/ZIP/BOQ
TEMP_DIR=./.data/tmp
MAX_UPLOAD_SIZE_MB=50

# ── Streamlit ─────────────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false

# ── React Web Console ─────────────────────────────────────────────────────────
WEB_PORT=80
VITE_API_URL=http://localhost:8000       # Must be reachable from browser (not docker internal)

# ── Async Workers ─────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
WORKER_QUEUE=bridgecad.default
WORKER_REDIS_URL=redis://localhost:6379/1

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=bridgecad-enterprise
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.05            # 5% sampling in prod

PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090

SENTRY_DSN=                              # optional — Sentry error tracking

# ── Email Notifications ───────────────────────────────────────────────────────
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=                     # ★ CHANGE IN PROD ★
EMAIL_FROM=no-reply@bridgecad.local
EMAIL_TLS=true

# ── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_EXPORT_SUCCESS=
WEBHOOK_EXPORT_FAILURE=
WEBHOOK_SECRET=                          # HMAC-SHA256 signing secret

# ── Drawing Generation ────────────────────────────────────────────────────────
DEFAULT_DRAWING_SCALE=100
DEFAULT_SHEET_SIZE=A1
DEFAULT_AUTOCAD_VERSION=R2018
DEFAULT_LAYER_STANDARD=IRC
DEFAULT_TITLE_BLOCK=STANDARD

# ── BOQ / Rates ───────────────────────────────────────────────────────────────
DEFAULT_BOQ_STATE=                       # two-letter state code e.g. MH (leave blank for national)
DEFAULT_CONTINGENCY_PCT=15
MORTH_RATES_YEAR=2024

# ── AI Optimizer ──────────────────────────────────────────────────────────────
AI_OPTIMIZER_ENABLED=true
AI_MAX_ITERATIONS=200
AI_SPAN_MAX_M=45
AI_COST_REGRESSION_TOLERANCE_PCT=20

# ── Feature Flags ─────────────────────────────────────────────────────────────
FEATURE_AI_OPTIMIZER=true
FEATURE_3D_EXPORT=false                  # three.js viewer — dev only
FEATURE_BILL_MORTH=true
FEATURE_PLUGIN_MARKET=false
FEATURE_MULTI_TENANT=false
FEATURE_REACT_CONSOLE=true
FEATURE_STREAMLIT_UI=true

# ── Plugin System ─────────────────────────────────────────────────────────────
PLUGIN_SCAN_DIRS=packages/bridgecad-plugins/bridgecad_plugins/plugins
PLUGIN_EXTRA_DIRS=                       # colon-separated extra plugin dirs

# ── Security ──────────────────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1        # comma-separated  ★ ADD DOMAIN IN PROD ★
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_JOBS=10
TRUSTED_PROXIES=172.16.0.0/12           # Docker bridge network
